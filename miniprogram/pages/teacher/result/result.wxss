.teacher-result-head {
  text-align: center;
}

.teacher-result-head .page-title {
  font-size: 34rpx;
}

.teacher-score {
  margin: 24rpx 0 8rpx;
  color: #1769ef;
  font-size: 52rpx;
  font-weight: 800;
}

.question-title {
  font-size: 28rpx;
  font-weight: 650;
}

.outcome {
  font-size: 24rpx;
  font-weight: 650;
}

.result-correct {
  color: #11965b;
}

.result-partial {
  color: #c48b13;
}

.result-wrong {
  color: #df4b4b;
}

.answer-line,
.comment-line {
  margin-top: 20rpx;
  line-height: 1.55;
}

.answer-label {
  display: block;
  margin-bottom: 4rpx;
  color: #8591a4;
  font-size: 22rpx;
}

.comment-line {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f8fc;
}

.score-line {
  margin-top: 18rpx;
  text-align: right;
}
