.heading {
  margin-bottom: 26rpx;
}

.logout-link {
  color: #75839a;
  font-size: 24rpx;
}

.teacher-banner {
  margin-bottom: 24rpx;
  padding: 38rpx 30rpx;
  border-radius: 22rpx;
  background: linear-gradient(115deg, #13a76d, #36c58a);
  color: #fff;
}

.teacher-banner-title {
  font-size: 38rpx;
  font-weight: 750;
}

.teacher-banner-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, .84);
}

.teacher-action {
  display: flex;
  align-items: center;
  min-height: 112rpx;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-weight: 700;
}

.blue {
  background: #3879f4;
}

.orange {
  background: #f1a735;
}

.action-copy {
  flex: 1;
}

.action-copy .muted {
  margin-top: 8rpx;
}

.action-count {
  margin-right: 18rpx;
  color: #1769ef;
  font-size: 36rpx;
  font-weight: 700;
}

.card-arrow {
  color: #9ca8b8;
  font-size: 42rpx;
}

.teacher-footnote {
  margin-top: 28rpx;
  text-align: center;
}
