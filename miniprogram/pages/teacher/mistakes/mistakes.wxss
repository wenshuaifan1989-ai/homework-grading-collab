.page-intro { margin: -12rpx 0 22rpx; line-height: 1.6; }
.controls { padding-top: 12rpx; }
.accuracy-label { margin-top: 18rpx; }
.section-title { margin-bottom: 18rpx; font-size: 31rpx; font-weight: 700; }
.source-row,.mistake-row { padding: 20rpx 0; border-bottom: 1rpx solid #e8edf4; }
.source-active { padding-right: 14rpx; padding-left: 14rpx; border-radius: 12rpx; background: #f2f6ff; }
.source-title { font-weight: 700; }
.crop-preview { width: 100%; max-height: 580rpx; margin: 16rpx 0; border-radius: 12rpx; background: #f2f4f7; }
.source-actions { display: flex; gap: 12rpx; margin: 14rpx 0; }
.compact { flex: 1; min-height: 72rpx; margin: 0; font-size: 24rpx; }
.bbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 18rpx; }
.bbox-grid label { color: #53627a; font-size: 23rpx; }
.short { min-height: 100rpx; }
.mistake-question { margin: 12rpx 0; font-size: 28rpx; line-height: 1.55; }
.text-button { display: block; margin: 14rpx auto; color: #1769ef; background: transparent; font-size: 24rpx; }
.history-box { padding: 18rpx; border-radius: 12rpx; background: #f5f8fc; }
.attempt-row { padding: 14rpx 0; border-bottom: 1rpx solid #e3eaf2; line-height: 1.6; }
.feedback-input { min-height: 90rpx; margin-top: 14rpx; }
.error-card { color: #bb3d3d; background: #fff3f2; }
.notice-card { color: #18754d; background: #eaf8f0; }
