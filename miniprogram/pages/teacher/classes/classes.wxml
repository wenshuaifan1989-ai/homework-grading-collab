<view class="page">
  <view class="row">
    <view class="page-title">我的班级</view>
    <text class="create-link" bindtap="createClass">＋ 创建班级</text>
  </view>
  <view class="invite-accept" bindtap="acceptTeacherInvite">输入教师邀请码加入班级 ›</view>
  <view wx:if="{{loading && !classes.length}}" class="empty">正在加载班级…</view>
  <view wx:elif="{{!classes.length}}" class="empty">还没有班级，先创建一个吧</view>
  <view wx:for="{{classes}}" wx:key="id" class="card class-card">
    <view class="row" data-id="{{item.id}}" bindtap="openDashboard">
      <view>
        <view class="class-title">{{item.name}}</view>
        <view class="muted class-count">学生 {{item.member_count}} 人</view>
      </view>
      <text class="card-arrow">›</text>
    </view>
    <view class="invite-row">
      <text class="muted">班级邀请码</text>
      <text class="invite-code">{{item.invite_code}}</text>
      <text class="copy-link" data-code="{{item.invite_code}}" catchtap="copyInvite">复制</text>
    </view>
    <view class="roster-link" data-id="{{item.id}}" catchtap="openRoster">学生名册 ›</view>
    <view class="roster-link" data-id="{{item.id}}" catchtap="openAssignments">发布作业 ›</view>
    <view class="roster-link" data-id="{{item.id}}" catchtap="openManagement">教师与班级管理 · {{item.teacher_role === 'owner' ? 'owner' : '教师'}} ›</view>
  </view>
</view>
