<view class="page">
  <view class="page-title">我的错题与订正</view>
  <view class="muted page-intro">当前账号绑定学生：{{selectedStudentName || '请选择学生'}}。题目来源与订正历史均由服务端按绑定关系校验。</view>
  <view wx:if="{{students.length > 1}}" class="card student-choices">
    <view class="muted">切换学生</view>
    <view class="choice-row">
      <view wx:for="{{students}}" wx:key="student_id" class="choice-chip {{selectedStudentId === item.student_id ? 'choice-active' : ''}}" data-id="{{item.student_id}}" bindtap="selectStudent">{{item.name}}</view>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="card error-card">{{errorMessage}}</view>
  <view wx:if="{{notice}}" class="card notice-card">{{notice}}</view>
  <view wx:if="{{loading && !mistakes.length}}" class="empty">正在读取错题…</view>
  <view wx:elif="{{!selectedStudentId}}" class="empty">当前账号尚无可访问的已绑定学生，请先完成身份绑定。<button class="secondary-button" bindtap="openBinding">前往身份绑定</button></view>
  <view wx:elif="{{!mistakes.length}}" class="empty">当前学生还没有已确认错题。</view>
  <view wx:for="{{mistakes}}" wx:key="id" class="card mistake-card">
    <view class="row"><text class="question-title">{{item.subject || '未标学科'}} · {{item.question_no || '待校对'}}</text><text class="pill">{{item.status}}</text></view>
    <view class="question-text">{{item.question.question_text || '题面待教师校对'}}</view>
    <view wx:if="{{item.question.knowledge_points_label}}" class="muted">知识点：{{item.question.knowledge_points_label}}</view>
    <view wx:else class="muted">知识点：待归类</view>
    <view wx:if="{{item.grading_result}}" class="muted">批改：{{item.grading_result.score}} / {{item.grading_result.max_score}} · {{item.grading_result.error_type || '错因待分析'}}</view>
    <view wx:if="{{item.question.correct_answer}}" class="answer-text">参考答案：{{item.question.correct_answer}}</view>
    <view wx:if="{{item.question.analysis}}" class="answer-text">解析：{{item.question.analysis}}</view>
    <view class="source-actions">
      <button class="secondary-button compact" data-item="{{item}}" data-kind="crop" bindtap="previewImage">查看单题裁切</button>
      <button class="secondary-button compact" data-item="{{item}}" data-kind="original" bindtap="previewImage">查看原作业页</button>
    </view>
    <text class="field-label">我的订正</text>
    <textarea class="textarea" data-id="{{item.id}}" value="{{item.draft}}" bindinput="onDraftInput" maxlength="2000" placeholder="写下重新计算或订正后的答案" />
    <button class="primary-button" data-id="{{item.id}}" bindtap="submitCorrection">提交订正</button>
    <button class="secondary-button" data-id="{{item.id}}" bindtap="markMastered">标记我已掌握</button>
    <button class="text-button" data-id="{{item.id}}" bindtap="toggleHistory">{{item.expanded ? '收起订正历史' : '查看订正历史'}}</button>
    <view wx:if="{{item.expanded}}" class="history-box">
      <view wx:if="{{!item.attempts.length}}" class="muted">暂无订正记录</view>
      <view wx:for="{{item.attempts}}" wx:for-item="attempt" wx:key="id" class="attempt-row">
        <view>{{attempt.attempt_type === 'mark_mastered' ? '自评掌握' : '订正'}} · {{attempt.status}}</view>
        <view wx:if="{{attempt.submitted_answer}}" class="muted">答案：{{attempt.submitted_answer}}</view>
        <view wx:if="{{attempt.review_feedback}}" class="muted">教师反馈：{{attempt.review_feedback}}</view>
        <view class="muted">{{attempt.created_at}}</view>
      </view>
    </view>
  </view>
</view>
