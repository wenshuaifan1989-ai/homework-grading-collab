.page-intro { margin: -12rpx 0 24rpx; line-height: 1.6; }
.student-choices { padding-bottom: 18rpx; }
.choice-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.choice-chip { padding: 12rpx 20rpx; border: 2rpx solid #e3eaf4; border-radius: 30rpx; color: #53627a; }
.choice-active { border-color: #1769ef; background: #f1f6ff; color: #1769ef; }
.mistake-card { padding: 26rpx; }
.question-title { font-weight: 700; }
.question-text { margin: 18rpx 0; font-size: 30rpx; line-height: 1.6; }
.answer-text { margin-top: 14rpx; line-height: 1.6; color: #53627a; }
.source-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.compact { flex: 1; min-height: 70rpx; margin-top: 0; font-size: 23rpx; }
.text-button { display: block; margin: 18rpx auto 0; background: transparent; color: #1769ef; font-size: 24rpx; }
.history-box { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; background: #f5f8fc; }
.attempt-row { padding: 14rpx 0; border-bottom: 1rpx solid #e4eaf2; line-height: 1.6; }
.error-card { color: #bb3d3d; background: #fff3f2; }
.notice-card { color: #18754d; background: #eaf8f0; }
.empty .secondary-button { max-width: 420rpx; }
